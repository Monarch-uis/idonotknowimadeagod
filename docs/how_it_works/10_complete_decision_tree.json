{
    "document_title": "Complete Decision Tree - What You See At Every Step",
    "description": "Every possible path through the program with the exact screens and messages you see",
    "when_you_start_the_program": {
        "step_1_initial_screen": {
            "what_you_see": [
                "═══════════════════════════════════════════════════",
                "  EPUB TO AUDIOBOOK CONVERTER",
                "═══════════════════════════════════════════════════"
            ]
        },
        "step_2_checkpoint_check": {
            "if_you_crashed_or_closed_mid_processing": {
                "what_you_see": [
                    "📌 CHECKPOINT FOUND",
                    "   Book: The Uzumaki Legend",
                    "   Progress: 7 of 25 chapters completed",
                    "   Last saved: 2025-12-15 14:30",
                    "",
                    "Resume from where you left off? (y/n):"
                ],
                "if_you_type_y": {
                    "what_happens": "Jumps directly to chapter 8, skips all configuration",
                    "what_you_see_next": "'📖 Resuming Chapter 8: The Battle Continues...'"
                },
                "if_you_type_n": {
                    "what_happens": "Checkpoint is deleted",
                    "what_you_see_next": "'🗑️ Checkpoint cleared. Starting fresh...'"
                }
            },
            "if_no_checkpoint_exists": {
                "what_happens": "This step is skipped, you go straight to temp cleanup check"
            }
        },
        "step_3_temp_cleanup_check": {
            "if_old_temp_files_exist": {
                "what_you_see": [
                    "🧹 Found 523 MB of temp files older than 5 days.",
                    "Clean up to save disk space? (y/n):"
                ],
                "if_you_type_y": {
                    "what_you_see": "'✅ Cleaned up 523 MB'",
                    "what_happens": "Old files deleted, continues to main menu"
                },
                "if_you_type_n": {
                    "what_you_see": "'Skipped cleanup.'",
                    "what_happens": "Files kept, continues to main menu"
                }
            },
            "if_no_old_files": {
                "what_happens": "This step is skipped, you go straight to main menu"
            }
        }
    },
    "main_menu_screen": {
        "what_you_see": [
            "",
            "═══════════════════════════════════════════════════",
            "  MAIN MENU",
            "═══════════════════════════════════════════════════",
            "  1. Process a new EPUB file",
